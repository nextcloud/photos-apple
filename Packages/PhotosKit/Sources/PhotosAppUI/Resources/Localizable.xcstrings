{
  "sourceLanguage" : "en",
  "strings" : {
    "" : {
      "comment" : "Empty label of a progress gauge. Leave empty."
    },
    "%@ is no longer shared with you" : {
      "comment" : "Settings › Partner sharing: a partner folder that was removed or moved. The argument is the folder's path."
    },
    "%@ is not in your library" : {
      "comment" : "Title of the question after choosing a backup folder that the timeline doesn't show. The placeholder is the folder path."
    },
    "%@ is not logged in on this device. To open the link, add the account under Settings › Accounts, then open the link again." : {
      "comment" : "A link names an account that is not logged in. %@ is user@server or the server's address."
    },
    "%@ now presents a different certificate, which is not trusted. Only trust it if you know that the certificate of your server was replaced.\n\n%@" : {
      "comment" : "Message of the dialog \"The server's certificate changed\" (opened from the account banner or Settings › Server). The first %@ is the server's host name, the second a summary of the new certificate (issuer, validity, fingerprint) on its own paragraph."
    },
    "%@ of %@" : {
      "comment" : "Progress of the on-device recognition in Settings › Search: photos looked at of all photos, e.g. \"1,234 of 5,000\"."
    },
    "%@ presents a different certificate than before. This happens when the server's certificate is replaced, but it is also what someone intercepting your connection would show. Until you decide, nothing is sent to the server." : {
      "comment" : "Explanation at the top of the sheet \"The server's certificate changed\" (opened from the account banner or Settings › Server). %@ is the server's host name."
    },
    "%@ uses http:// instead of https://. The album and its photos would be sent unencrypted, and anyone on the network could see them." : {
      "comment" : "Message of the warning before opening a public album link over http://. %@ is the server's host name. \"http://\" and \"https://\" stay as they are."
    },
    "%@ uses http:// instead of https://. Your password and all your photos would be sent unencrypted, and anyone on the network could read them. Only continue if you trust the network between you and this server." : {
      "comment" : "Warning before logging in to a server without encryption. %@ is the server's host name. \"http://\" and \"https://\" stay as they are."
    },
    "%@ · %@" : {
      "comment" : "A section header that displays the category title and the size of the items in that category.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · %2$@"
          }
        }
      }
    },
    "%lld albums" : {
      "comment" : "Backup screen, Albums row: how many device albums are mirrored. Has plural forms.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld album"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld albums"
                }
              }
            }
          }
        }
      }
    },
    "%lld albums haven't been opened on this device yet; whether the copies are in them couldn't be checked." : {
      "comment" : "Duplicates, delete confirmation: albums whose content the app has not loaded yet, so they could not be checked for the copies. Has plural forms.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld album hasn't been opened on this device yet; whether the copies are in it couldn't be checked."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld albums haven't been opened on this device yet; whether the copies are in them couldn't be checked."
                }
              }
            }
          }
        }
      }
    },
    "%lld already on your Nextcloud" : {
      "comment" : "Backup set-up, after the check: how many of the device's photos and videos are already on the server."
    },
    "%lld changes couldn't be saved on the server." : {
      "comment" : "A banner that shows a warning that some changes couldn't be saved. The argument is the number of failed operations.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
