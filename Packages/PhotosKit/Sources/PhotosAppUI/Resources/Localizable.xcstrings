{
  "sourceLanguage" : "en",
  "strings" : {
    "" : {
      "comment" : "Empty label of a progress gauge. Leave empty."
    },
    "%@ Copy" : {
      "comment" : "Name of a duplicated smart album. The argument is the original name."
    },
    "%@ Isn't Available" : {
      "comment" : "Alert title when a link opens a screen the server cannot fill. Placeholder: the screen (People, Tags…)."
    },
    "%@ available" : {
      "comment" : "Clean up: free storage on the iPhone, iPad or Mac. The placeholder is a size."
    },
    "%@ can't be changed and will be skipped." : {
      "comment" : "Batch fixes sheet: warning. The argument is e.g. '3 items'."
    },
    "%@ clipped" : {
      "comment" : "Culling view: share of the photo with blown highlights or blocked shadows."
    },
    "%@ curve point %lld" : {
      "comment" : "Curves tool, VoiceOver: one point of the curve. %1$@ is the channel, %2$lld its number.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ curve point %2$lld"
          }
        }
      }
    },
    "%@ in review" : {
      "comment" : "Year in review title, e.g. 2025 in review: the screen title, the heading of every card and the video file name."
    },
    "%@ is no longer shared with you" : {
      "comment" : "Settings › Partner sharing: a partner folder that was removed or moved. The argument is the folder's path."
    },
    "%@ is not in your library" : {
      "comment" : "Title of the question after choosing a backup folder that the timeline doesn't show. The placeholder is the folder path."
    },
    "%@ is not logged in on this device. To open the link, add the account under Settings › Accounts, then open the link again." : {
      "comment" : "A link names an account that is not logged in. %@ is user@server or the server's address."
    },
    "%@ mm" : {
      "comment" : "A focal length, e.g. 35 mm."
    },
    "%@ music" : {
      "comment" : "Memory film: the music made for a film style, e.g. 'Upbeat music'. The argument is the style's name."
    },
    "%@ now presents a different certificate, which is not trusted. Only trust it if you know that the certificate of your server was replaced.\n\n%@" : {
      "comment" : "Message of the dialog \"The server's certificate changed\" (opened from the account banner or Settings › Server). The first %@ is the server's host name, the second a summary of the new certificate (issuer, validity, fingerprint) on its own paragraph."
    },
    "%@ of %@" : {
      "comment" : "Progress of the on-device recognition in Settings › Search: photos looked at of all photos, e.g. \"1,234 of 5,000\"."
    },
    "%@ of the world" : {
      "comment" : "Countries: the share of the world's 195 countries visited, e.g. \"19 % of the world\"."
    },
    "%@ old" : {
      "comment" : "Through the years: the person's age under the date, e.g. '3 years old'."
    },
    "%@ presents a different certificate than before. This happens when the server's certificate is replaced, but it is also what someone intercepting your connection would show. Until you decide, nothing is sent to the server." : {
      "comment" : "Explanation at the top of the sheet \"The server's certificate changed\" (opened from the account banner or Settings › Server). %@ is the server's host name."
    },
    "%@ s" : {
      "comment" : "A shutter speed of a second or longer, e.g. 2 s."
    },
    "%@ to %@" : {
      "comment" : "Memory film: caption of a map flight from one place to another.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ to %2$@"
          }
        }
      }
    },
    "%@ uses http:// instead of https://. The album and its photos would be sent unencrypted, and anyone on the network could see them." : {
      "comment" : "Message of the warning before opening a public album link over http://. %@ is the server's host name. \"http://\" and \"https://\" stay as they are."
    },
    "%@ uses http:// instead of https://. Your password and all your photos would be sent unencrypted, and anyone on the network could read them. Only continue if you trust the network between you and this server." : {
      "comment" : "Warning before logging in to a server without encryption. %@ is the server's host name. \"http://\" and \"https://\" stay as they are."
    },
    "%@ · %@" : {
      "comment" : "A section header that displays the category title and the size of the items in that category.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · %2$@"
          }
        }
      }
    },
    "%@ · %lld photos" : {
      "comment" : "Space smart offline uses and how many photos it keeps, in Settings, e.g. \"1.2 GB · 1,840 photos\". Plural variations in the catalog.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %#@photos@"
          },
          "substitutions" : {
            "photos" : {
              "argNum" : 2,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg photo"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg photos"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "%@%lld h" : {
      "comment" : "GPS track: camera clock correction, e.g. +2 h. The first argument is the sign (+ or −).",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@%2$lld h"
          }
        }
      }
    },
    "%@%lld h %lld min" : {
      "comment" : "GPS track: camera clock correction, e.g. −1 h 30 min. The first argument is the sign (+ or −).",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@%2$lld h %3$lld min"
          }
        }
      }
    },
    "%@%lld min" : {
      "comment" : "GPS track: camera clock correction, e.g. +15 min. The first argument is the sign (+ or −).",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@%2$lld min"
          }
        }
      }
    },
    "%@, %@" : {
      "comment" : "VoiceOver: keeper rate of a lens, then e.g. 12 of 40 photos kept."
    },
    "%@, %@ · %lld s" : {
      "comment" : "Batch fixes, GPS track tab: the position a photo gets (latitude, longitude) and the seconds between the photo and the nearest track point.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, %2$@ · %3$lld s"
          }
        }
      }
    },
    "%@, smart album, %@" : {
      "comment" : "Accessibility label of a smart album card: its name and how many items it has.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, smart album, %2$@"
