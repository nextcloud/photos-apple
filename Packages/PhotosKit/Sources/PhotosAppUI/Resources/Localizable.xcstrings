                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld changes couldn't be saved on the server."
                }
              }
            }
          }
        }
      }
    },
    "%lld copies" : {
      "comment" : "Part of a photo tile's VoiceOver label in the library: the tile stands for this many copies of one photo (for example HEIC and JPEG, or RAW and JPEG). Has plural forms.",
      "localizations" : {
        "en" : {
          "variations" : {
