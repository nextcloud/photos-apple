        }
      }
    },
    "%@, up to %@" : {
      "comment" : "Settings › Storage, the preview cache: its size and its limit, e.g. \"1.2 GB, up to 2 GB\"."
    },
    "%lld (%@)" : {
      "comment" : "Settings › Cache performance: a number of previews and its share, e.g. “120 (40 %)”."
    },
