                }
              }
            }
          }
        }
      }
    },
    "Backup finished." : {
      "comment" : "Result of a backup run that uploaded everything."
    },
    "Backup finished. %lld items that are only in iCloud were not backed up, because downloading from iCloud is turned off." : {
      "comment" : "Result of a backup run (\"Back up now\" shortcut, background backup) when everything was uploaded except photos whose originals are only in iCloud. %lld is their number. \"Download originals from iCloud\" is an option on the Backup screen.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Backup finished. %lld item that is only in iCloud was not backed up, because downloading from iCloud is turned off."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Backup finished. %lld items that are only in iCloud were not backed up, because downloading from iCloud is turned off."
                }
              }
            }
          }
        }
      }
    },
    "Backup is not turned on in Nextcloud Photos." : {
      "comment" : "Result of the \"Back up now\" shortcut when backup is turned off in the app. \"Nextcloud Photos\" is the app's name."
    },
    "Backup is paused: %@" : {
      "comment" : "Result of a backup run that is waiting. %@ is the reason, a sentence fragment such as \"Waiting for Wi-Fi\"."
    },
    "Backup is paused: log in to %@ on %@ again." : {
      "comment" : "Result of a backup run when the account's login expired. The first %@ is the account's name, the second the server's host name.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Backup is paused: log in to %1$@ on %2$@ again."
          }
        }
      }
    },
    "Backup paused" : {
      "comment" : "Backup Live Activity and widget: title while it waits."
    },
    "Backup stopped" : {
      "comment" : "Backup Live Activity and widget: the user has to fix something."
    },
    "Backup stopped: free up space on this Mac." : {
      "comment" : "Result of a backup run on the Mac that stopped because the disk is full (each photo is copied before it is uploaded)."
    },
    "Backup stopped: free up space on this device." : {
      "comment" : "Result of a backup run on iPhone or iPad that stopped because the device storage is full (each photo is copied before it is uploaded)."
    },
    "Backup stopped: log in to your Nextcloud again." : {
      "comment" : "Result of a backup run that stopped because the login is no longer valid."
    },
    "Backup stopped: the connection to your Nextcloud is not trusted." : {
      "comment" : "Result of a backup run that stopped because the server's certificate is not trusted."
    },
    "Backup stopped: the server does not allow uploads to the backup folder." : {
      "comment" : "Result of a backup run that stopped because the server refused the upload (no permission)."
    },
    "Backup stopped: your Nextcloud storage is full." : {
      "comment" : "Result of a backup run that stopped because the user's storage quota on the server is used up."
    },
    "Backup was interrupted. It continues the next time Nextcloud Photos is running." : {
      "comment" : "Result of a backup run that the system ended early. \"Nextcloud Photos\" is the app's name."
    },
    "Cancelled" : {
      "comment" : "Status of an upload or download that the user cancelled, in the list of transfers."
    },
    "Changed on the server in the meantime. Try again after the next sync." : {
      "comment" : "Batch fixes: why a photo was not changed (newer version on the server)."
    },
    "Checking your Nextcloud… %lld of %lld" : {
      "comment" : "Subtitle of the system's backup progress panel while the app compares the device's photos with the server."
    },
    "Connect to your server once to start rating: the app creates the tags for ratings and flags there." : {
      "comment" : "Culling error: the rating tags must be created on the server, which cannot be reached."
    },
    "Continues when Nextcloud Photos runs again" : {
      "comment" : "Backup Live Activity and widget: the system stopped the backup in the background; it goes on later."
    },
    "Delete" : {
      "comment" : "Name of an action in Edit › Undo / Redo (shown as \"Undo Delete\"): photos were moved to the server's trash bin. A verb."
    },
    "Edit" : {
      "comment" : "Edit › Undo Edit: the undo action's name for a photo edited in the editor."
    },
    "From your favorites · %@" : {
      "comment" : "Daily photo notification when the photo is a favourite: the argument is its month and year, e.g. June 2019."
    },
    "It's %@'s birthday today. Look back at their birthdays and send a photo?" : {
      "comment" : "Body of the birthday reminder notification, on the day."
    },
    "Log in to back up your photos." : {
      "comment" : "Result of the \"Back up now\" shortcut when no account is logged in."
    },
    "Looking for new photos…" : {
      "comment" : "Subtitle of the system's backup progress panel before the uploads start."
    },
    "Nextcloud Photos has no access to your photos." : {
      "comment" : "Result of a backup run when the user has not allowed the app to read the device's photo library. \"Nextcloud Photos\" is the app's name."
    },
    "On this day %lld years ago" : {
      "comment" : "Daily photo notification: the photo was taken on this day N years ago. Plural variations in the catalog.",
      "localizations" : {
