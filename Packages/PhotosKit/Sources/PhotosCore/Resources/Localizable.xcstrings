{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ left" : {
      "comment" : "Backup Live Activity: the size of what is still to upload, e.g. “1.2 GB left”."
    },
    "%@ shared the album with you." : {
      "comment" : "Notification body; the title is the album's title. %@ is the display name of the owner."
    },
    "%@'s birthday" : {
      "comment" : "Title of the birthday reminder notification."
    },
    "%lld items were backed up, %lld are still waiting." : {
      "comment" : "Result of a backup run that ended before everything was uploaded, spoken or shown by the \"Back up now\" shortcut. Both numbers have plural forms.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@uploaded@, %#@remaining@."
          },
          "substitutions" : {
