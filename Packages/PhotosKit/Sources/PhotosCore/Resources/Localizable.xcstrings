        }
      }
    },
    "This week: %@. %@" : {
      "comment" : "Body of the weekly photo prompt reminder: the theme, then its hint, e.g. This week: Hands. Hands at work, at rest, holding on.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This week: %1$@. %2$@"
          }
        }
      }
    },
    "Unarchive" : {
      "comment" : "Name of an action in Edit › Undo / Redo (shown as \"Undo Unarchive\"): photos were taken out of the archive and are shown in the library again. A verb."
    },
    "Uploading %lld of %lld" : {
      "comment" : "Subtitle of the system's backup progress panel: the number of the file being uploaded, of all files."
    },
    "Weekly Photo Prompt" : {
      "comment" : "Title of the weekly photo prompt reminder notification."
    },
    "Your login could not be saved in the keychain (error %@)." : {
      "comment" : "Shown when a login cannot be completed because the app could not store the app password in the system keychain. The placeholder is the system's error number (e.g. -34018), not formatted."
    },
    "Your organization allows only one account in this app." : {
      "comment" : "Login refused by the device management: a second account cannot be added."
    },
    "Your organization only allows logging in to %@." : {
      "comment" : "Login refused by the device management. %@ is the server's host name."
    },
    "Your photos are backed up." : {
      "comment" : "Result of a backup run when there was nothing left to upload."
    },
    "Your server only lets administrators create tags. Ask your administrator to create these collaborative tags: %@." : {
      "comment" : "Culling error. The placeholder is a list of tag names such as ★★★, Pick, Rejected."
    }
