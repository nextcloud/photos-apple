{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ shared the album with you." : {
      "comment" : "Notification body; the title is the album's title. %@ is the display name of the owner."
    },
    "%lld items were backed up, %lld are still waiting." : {
      "comment" : "Result of a backup run that ended before everything was uploaded, spoken or shown by the \"Back up now\" shortcut. Both numbers have plural forms.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@uploaded@, %#@remaining@."
          },
          "substitutions" : {
            "uploaded" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg item was backed up"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg items were backed up"
                    }
                  }
                }
              }
            },
            "remaining" : {
              "argNum" : 2,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg is still waiting"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg are still waiting"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "%lld items you shared to Nextcloud Photos could not be uploaded. Share them again to try once more." : {
      "comment" : "Text of a notification: %lld is the number of shared items that could not be uploaded after the share sheet was closed."
    },
    "%lld new photos" : {
      "comment" : "Notification body about a shared album (its title is the title): how many photos others added.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld new photo"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld new photos"
                }
              }
            }
          }
        }
      }
    },
    "Add to Favorites" : {
      "comment" : "Name of an action in Edit › Undo / Redo on the Mac and iPad (shown as \"Undo Add to Favorites\"): photos were marked as favourites. Title-style capitalisation as in the menu bar."
    },
    "An album was shared with you." : {
      "comment" : "Notification body; the title is the album's title."
    },
    "Archive" : {
      "comment" : "Name of an action in Edit › Undo / Redo (shown as \"Undo Archive\"): photos were moved to the archive. A verb."
    },
    "Backing up photos to Nextcloud" : {
      "comment" : "Title of the system's progress panel (Live Activity) while a backup the user started runs in the background."
    },
    "Backup failed: %@" : {
      "comment" : "Result of a backup run that failed. %@ is the error message."
    },
    "Backup finished, but %lld items could not be uploaded." : {
      "comment" : "Result of a backup run where some photos or videos failed to upload. %lld is their number.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Backup finished, but %lld item could not be uploaded."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Backup finished, but %lld items could not be uploaded."
                }
              }
            }
          }
        }
      }
    },
    "Backup finished." : {
      "comment" : "Result of a backup run that uploaded everything."
    },
    "Backup finished. %lld items that are only in iCloud were not backed up, because downloading from iCloud is turned off." : {
      "comment" : "Result of a backup run (\"Back up now\" shortcut, background backup) when everything was uploaded except photos whose originals are only in iCloud. %lld is their number. \"Download originals from iCloud\" is an option on the Backup screen.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Backup finished. %lld item that is only in iCloud was not backed up, because downloading from iCloud is turned off."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Backup finished. %lld items that are only in iCloud were not backed up, because downloading from iCloud is turned off."
                }
              }
            }
          }
        }
      }
    },
    "Backup is not turned on in Nextcloud Photos." : {
      "comment" : "Result of the \"Back up now\" shortcut when backup is turned off in the app. \"Nextcloud Photos\" is the app's name."
    },
    "Backup is paused: %@" : {
      "comment" : "Result of a backup run that is waiting. %@ is the reason, a sentence fragment such as \"Waiting for Wi-Fi\"."
    },
    "Backup is paused: log in to %@ on %@ again." : {
      "comment" : "Result of a backup run when the account's login expired. The first %@ is the account's name, the second the server's host name.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Backup is paused: log in to %1$@ on %2$@ again."
          }
        }
      }
    },
    "Backup stopped: free up space on this Mac." : {
      "comment" : "Result of a backup run on the Mac that stopped because the disk is full (each photo is copied before it is uploaded)."
    },
    "Backup stopped: free up space on this device." : {
      "comment" : "Result of a backup run on iPhone or iPad that stopped because the device storage is full (each photo is copied before it is uploaded)."
    },
    "Backup stopped: log in to your Nextcloud again." : {
      "comment" : "Result of a backup run that stopped because the login is no longer valid."
    },
    "Backup stopped: the connection to your Nextcloud is not trusted." : {
      "comment" : "Result of a backup run that stopped because the server's certificate is not trusted."
    },
    "Backup stopped: the server does not allow uploads to the backup folder." : {
      "comment" : "Result of a backup run that stopped because the server refused the upload (no permission)."
    },
    "Backup stopped: your Nextcloud storage is full." : {
      "comment" : "Result of a backup run that stopped because the user's storage quota on the server is used up."
    },
    "Backup was interrupted. It continues the next time Nextcloud Photos is running." : {
      "comment" : "Result of a backup run that the system ended early. \"Nextcloud Photos\" is the app's name."
    },
    "Cancelled" : {
      "comment" : "Status of an upload or download that the user cancelled, in the list of transfers."
    },
    "Checking your Nextcloud… %lld of %lld" : {
      "comment" : "Subtitle of the system's backup progress panel while the app compares the device's photos with the server."
    },
    "Delete" : {
      "comment" : "Name of an action in Edit › Undo / Redo (shown as \"Undo Delete\"): photos were moved to the server's trash bin. A verb."
    },
    "Log in to back up your photos." : {
      "comment" : "Result of the \"Back up now\" shortcut when no account is logged in."
    },
    "Looking for new photos…" : {
      "comment" : "Subtitle of the system's backup progress panel before the uploads start."
    },
    "Nextcloud Photos has no access to your photos." : {
      "comment" : "Result of a backup run when the user has not allowed the app to read the device's photo library. \"Nextcloud Photos\" is the app's name."
    },
    "Only the photos you selected for Nextcloud Photos are backed up." : {
      "comment" : "Added to the result of a backup run when the user gave the app access to selected photos only (limited Photos access). \"Nextcloud Photos\" is the app's name."
    },
    "Only your own photos can be shared by link." : {
      "comment" : "Error message when the user tries to create a share link for photos that someone else shared with them."
    },
    "Remove from Album" : {
      "comment" : "Name of an action in Edit › Undo / Redo (shown as \"Undo Remove from Album\"): photos were removed from an album. Title-style capitalisation as in the menu bar."
    },
    "Remove from Favorites" : {
      "comment" : "Name of an action in Edit › Undo / Redo (shown as \"Undo Remove from Favorites\"): photos are no longer favourites. Title-style capitalisation as in the menu bar."
    },
    "Shared items were not uploaded" : {
      "comment" : "Title of a notification: items the user shared to Nextcloud Photos from another app could not be uploaded after the share sheet was closed."
    },
    "Shared on %@" : {
      "comment" : "Name of the album that is created when the user shares photos with a link. %@ is today's date, e.g. \"Shared on 23 Nov 2026\"."
    },
    "Unarchive" : {
      "comment" : "Name of an action in Edit › Undo / Redo (shown as \"Undo Unarchive\"): photos were taken out of the archive and are shown in the library again. A verb."
    },
    "Uploading %lld of %lld" : {
      "comment" : "Subtitle of the system's backup progress panel: the number of the file being uploaded, of all files."
    },
    "Your photos are backed up." : {
      "comment" : "Result of a backup run when there was nothing left to upload."
    }
  },
  "version" : "1.1"
}