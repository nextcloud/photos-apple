                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg item was backed up"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg items were backed up"
                    }
                  }
                }
              }
            },
