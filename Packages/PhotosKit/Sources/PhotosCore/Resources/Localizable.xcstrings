    "A birthday today" : {
      "comment" : "Birthday reminder while app lock is on."
    },
    "A photo from your library is waiting for you." : {
      "comment" : "Body of the daily photo notification while app lock is on: no photo, date or place is shown."
    },
    "Add to Album" : {
      "comment" : "Edit › Undo Add to Album (the undo action's name)."
    },
    "Add to Favorites" : {
      "comment" : "Name of an action in Edit › Undo / Redo on the Mac and iPad (shown as \"Undo Add to Favorites\"): photos were marked as favourites. Title-style capitalisation as in the menu bar."
    },
    "Album" : {
      "comment" : "Spotlight: kind of a result that is an album."
    },
    "An album was shared with you." : {
      "comment" : "Notification body; the title is the album's title."
    },
    "Another file in the folder already has this name." : {
      "comment" : "Batch rename: why a photo was not renamed."
    },
    "Archive" : {
      "comment" : "Name of an action in Edit › Undo / Redo (shown as \"Undo Archive\"): photos were moved to the archive. A verb."
    },
    "Backed up" : {
      "comment" : "Backup Live Activity and widget: everything is on the server."
    },
    "Backing up photos to Nextcloud" : {
      "comment" : "Title of the system's progress panel (Live Activity) while a backup the user started runs in the background."
    },
    "Backup failed: %@" : {
      "comment" : "Result of a backup run that failed. %@ is the error message."
    },
    "Backup finished, but %lld items could not be uploaded." : {
      "comment" : "Result of a backup run where some photos or videos failed to upload. %lld is their number.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
